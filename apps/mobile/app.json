{
  "expo": {
    "name": "Kavi",
    "slug": "kavi",
    "scheme": "kavi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.logicbaker.kavi",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/ios-dark.png",
        "tinted": "./assets/ios-tinted.png"
      }
    },
    "android": {
      "package": "com.usekavi.app",
      "adaptiveIcon": {
        "backgroundColor": "#3DAA84",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3DAA84"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": false,
          "remindersPermission": "Kavi adds your grocery list to a Reminders list so you can check items off while you shop. Kavi only adds items to its own list."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.logicbaker.kavi.widgets",
          "groupIdentifier": "group.com.logicbaker.kavi",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "KaviToday",
              "displayName": "Today’s Meals",
              "description": "Breakfast, lunch, dinner, and your grocery progress.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "widgets/KaviToday.tsx"
              },
              "android": null
            },
            {
              "name": "KaviGroceries",
              "displayName": "Grocery List",
              "description": "What is left to buy, and how far along your shopping trip is.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "widgets/KaviGroceries.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ]
  }
}
