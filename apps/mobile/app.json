{
  "expo": {
    "name": "Kavi",
    "slug": "kavi",
    "scheme": "kavi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usekavi.app"
    },
    "android": {
      "package": "com.usekavi.app",
      "adaptiveIcon": {
        "backgroundColor": "#3DAA84",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3DAA84"
        }
      ],
      "expo-font"
    ]
  }
}
